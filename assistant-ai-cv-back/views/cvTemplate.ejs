<!DOCTYPE html>
<html lang="fr">
<head>
  <meta charset="UTF-8" />
  <title><%= cv_title %></title>
  <style>
    body {
      font-family: Arial, sans-serif;
      margin: 40px;
      color: #333;
      line-height: 1.4;
    }
    .header {
      text-align: center;
      margin-bottom: 30px;
    }
    .header h1 {
      font-size: 32px;
      margin: 0;
      font-weight: bold;
    }
    .header h2 {
      font-size: 18px;
      margin: 5px 0;
      font-weight: normal;
      color: #666;
    }
    .header .contact {
      font-size: 12px;
      color: #444;
      margin-top: 8px;
    }
    section {
      margin-bottom: 20px;
    }
    section h3 {
      font-size: 14px;
      text-transform: uppercase;
      font-weight: bold;
      margin: 0 0 5px 0;
      padding-bottom: 3px;
      border-bottom: 1px solid #000;
    }
    section p {
      margin: 0;
      font-size: 12px;
    }
    section ul {
      list-style: disc inside;
      margin: 5px 0 0 0;
      padding: 0;
    }
    section ul li {
      margin-bottom: 4px;
      font-size: 12px;
    }
  </style>
</head>
<body>
<div class="header">
  <h1><%= full_name %></h1>
  <h2><%= cv_title %></h2>
  <p class="contact"><%- contact_block.replace(/\*\*(.*?)\*\*/g, '<strong>$1</strong>') %></p>
</div>

<% if (typeof profile !== 'undefined' && profile) { %>
  <section>
    <h3>Résumé</h3>
    <p><%- profile.replace(/\*\*(.*?)\*\*/g, '<strong>$1</strong>') %></p>
  </section>
<% } %>

<% if (typeof experiences !== 'undefined' && experiences.items && experiences.items.length) { %>
  <section>
    <h3><%= experiences.title %></h3>
    <ul>
      <% experiences.items.forEach(item => { %>
        <li><%- item.replace(/\*\*(.*?)\*\*/g, '<strong>$1</strong>') %></li>
      <% }) %>
    </ul>
  </section>
<% } %>

<% if (typeof educations !== 'undefined' && educations.items && educations.items.length) { %>
